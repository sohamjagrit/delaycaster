# Copy to .env and fill in real values. NEVER commit the real .env (it's gitignored).
# These are only needed for local scripts / the Streamlit app — NOT inside Databricks
# (Databricks reads the storage key from a secret scope, not from this file).

# --- Azure storage (ADLS Gen2) ---
AZURE_STORAGE_ACCOUNT=delaycasterdata
AZURE_STORAGE_CONTAINER=data
# Storage account key — find under: Storage account > Security + networking > Access keys
AZURE_STORAGE_KEY=your-storage-account-key-here

# --- AzureML (filled in during Stage 2) ---
AZUREML_SUBSCRIPTION_ID=
AZUREML_RESOURCE_GROUP=delaycaster-rg
AZUREML_WORKSPACE_NAME=
